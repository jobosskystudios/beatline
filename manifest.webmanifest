{
  "name": "Beatline",
  "short_name": "Beatline",
  "description": "Beat markers, song sections and cut plans for Final Cut Pro.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1115",
  "theme_color": "#171a21",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": { "audio/*": [".wav", ".aif", ".aiff", ".mp3", ".m4a", ".aac", ".flac"] }
    }
  ]
}
